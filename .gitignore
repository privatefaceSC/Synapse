# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# IDE
.idea/
.vscode/

# OS
.DS_Store
Thumbs.db

# Database (локальный SQLite, не должен попадать в репо)
db/*.db
db/*.backup-*

# Telethon-сессия Telegram (полный доступ к аккаунту — НИКОГДА в репо)
db/*.session
db/*.session-journal
tg.session*

# Локальные секреты Telegram (api_id / api_hash) — НИКОГДА в репо
tg_credentials.bat

# Локальные настройки Telegram-моста (фильтрация) — у каждого свои
db/tg_settings.json

# Build artifacts
dist/

# Зашифрованные медиа-вложения (локальное хранилище)
media/

# Случайные скриншоты/логи/дампы
screen.png
*.log
_dump.txt
intents_dump.txt
notif_dump*.txt

# Локальные заметки по проекту (не код)
Аннотация.txt
Описание проекта.txt
Техническое задание.txt

# Тесты держим только локально, в репозиторий не кладём
tests/

# Android-клиент держим только локально (для веб-проекта/защиты не нужен)
android/
