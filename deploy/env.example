# Скопировать на сервер в /etc/synapse/synapse.env и заполнить реальные значения.
# Не коммитить файл с настоящими ключами.

TZ=Europe/Moscow
PYTHONUNBUFFERED=1

# Где на сервере лежат постоянные данные.
SKILLWOOD_DB_PATH=/srv/synapse/db/blogs.db
SKILLWOOD_MEDIA_ROOT=/srv/synapse/media
# Необязательный постоянный ключ подписи web-сессий. Если меняете его,
# все пользователи один раз войдут заново.
SKILLWOOD_SECRET_KEY=
# Дополнительные владельцы раздела «Пользователи», через запятую.
SKILLWOOD_USERS_ADMIN_EMAILS=

# Обязательно заменить на свой Fernet-ключ:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SKILLWOOD_ENCRYPTION_KEY=PASTE_GENERATED_FERNET_KEY_HERE

# Telegram API: взять на https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_OWNER_USER_ID=1
TELEGRAM_MEDIA_MAX_MB=20
# Общий предел media/: при достижении новые вложения получают понятную ошибку,
# а SQLite/WSGI сохраняют запас места. Для квоты AlwaysData 1 ГБ — 450 МБ.
SKILLWOOD_MEDIA_STORE_MAX_MB=450
# Фоновая цель ниже жёсткого предела: старые восстанавливаемые
# Telegram photo/video становятся «не загружены», оставляя место базе и логам.
SKILLWOOD_MEDIA_CACHE_TARGET_MB=350
SKILLWOOD_MEDIA_CLEANUP_INTERVAL_MINUTES=30
TELEGRAM_CATCHUP_IMAGE_MAX_MB=8

# Поведение Telegram-моста.
TELEGRAM_SYNC_MUTED=1
TELEGRAM_SKIP_ARCHIVED=1
TELEGRAM_GHOST_MODE=1

# Перевод сообщений без локальной Ollama. По умолчанию выключен: выберите
# один провайдер и заполните только его настройки. Реальные ключи храните
# только в серверном env-файле, не в git.
# Допустимые значения: libretranslate или yandex.
TRANSLATION_PROVIDER=

# Любой совместимый LibreTranslate REST-сервер. Можно указать корень сервера
# или полный адрес /translate. Ключ необязателен для self-hosted инстансов.
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

# Yandex Cloud Translate API v2. Запросы отправляются с отключённым
# серверным логированием содержимого (x-data-logging-enabled: false).
YANDEX_TRANSLATE_API_KEY=
YANDEX_TRANSLATE_FOLDER_ID=

# Web Push для фоновых уведомлений браузера.
# Приватный VAPID-ключ сервер создаёт сам в db/webpush_vapid_private.pem.
WEB_PUSH_SUBJECT=mailto:admin@example.com
