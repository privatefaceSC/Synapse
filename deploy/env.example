# Скопировать на сервер в /etc/synapse/synapse.env и заполнить реальные значения.
# Не коммитить файл с настоящими ключами.

TZ=Europe/Moscow
PYTHONUNBUFFERED=1

# Где на сервере лежат постоянные данные.
SKILLWOOD_DB_PATH=/srv/synapse/db/blogs.db
SKILLWOOD_MEDIA_ROOT=/srv/synapse/media

# Обязательно заменить на свой Fernet-ключ:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SKILLWOOD_ENCRYPTION_KEY=PASTE_GENERATED_FERNET_KEY_HERE

# Telegram API: взять на https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_OWNER_USER_ID=1
TELEGRAM_MEDIA_MAX_MB=20
# Общий предел media/: при достижении новые вложения получают понятную ошибку,
# а SQLite/WSGI сохраняют запас места. Для квоты AlwaysData 1 ГБ — 650 МБ.
SKILLWOOD_MEDIA_STORE_MAX_MB=650
TELEGRAM_CATCHUP_IMAGE_MAX_MB=8

# Поведение Telegram-моста.
TELEGRAM_SYNC_MUTED=1
TELEGRAM_SKIP_ARCHIVED=1
TELEGRAM_GHOST_MODE=1

# Web Push для фоновых уведомлений браузера.
# Приватный VAPID-ключ сервер создаёт сам в db/webpush_vapid_private.pem.
WEB_PUSH_SUBJECT=mailto:admin@example.com
